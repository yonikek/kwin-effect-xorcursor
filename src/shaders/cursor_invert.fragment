/*
    SPDX-FileCopyrightText: 2025 Jin Liu <m.liu.jin@gmail.com>

    SPDX-License-Identifier: GPL-2.0-or-later

    Inverts the screen content underneath the cursor, in the style of the
    "Invert screen color" accessibility option of Plasma's invert effect:

        gl_FragColor = vec4(1.0 - color.rgb, color.a) * alpha;

    Two adaptations are required to use this idea as a cursor shader:

    * The composited background is read back through a grabber FBO. Since
      the grabbed pixels have to be interpreted in the render target's
      colorspace (and possibly re-encoded when rendering to an HDR output),
      the inversion happens on linear-light values: we first apply the
      inverse EOTF, invert with `1.0 - color` and then re-apply the EOTF of
      the render target. For a plain 8-bit sRGB framebuffer this yields
      results visually equivalent to the old GL_XOR logic op while staying
      correct on wide-gamut / HDR outputs.

    * A cursor image is not opaque: only pixels covered by the shape should
      invert the background, anti-aliased edge pixels should invert only
      partially and fully transparent pixels must leave the background
      untouched. We achieve that by mixing between the original backdrop
      and the inverted backdrop using the cursor coverage as factor.

    Because the inversion is computed entirely in this shader and masked by
    the cursor's alpha channel, no fixed-function GL_COLOR_LOGIC_OP is used
    and any cursor colour or theme works: the RGB values of the cursor image
    are never consumed at all.

    NOTE: the colorspace helper functions (toLinearColor/toTransferColor)
    normally come from KWin's "colorspace.glsl", which is #included by
    ShaderManager at runtime from kwin's own shaders resource directory. To
    keep this standalone plugin self-contained, equivalent implementations
    are provided inline below.
*/

#extension GL_OES_standard_vulkan_texture_descriptor_set : enable

uniform sampler2D samplers[3];

// 0: background texture (the freshly grabbed, composited screen content)
// 1: cursor texture
// 2: (unused)

const int BackgroundTextureUnit = 0;
const int CursorTextureUnit = 1;

uniform mat4 ModelViewProjectionMatrix;

in vec2 texcoord;
in vec4 color; // per-vertex modulation color (unused here)

// Colorspace conversion uniforms, mirroring ShaderTrait::TransformColorspace.
// They are filled in from C++ via GLShader::setColorspaceUniforms().
uniform int srcEOTF;
uniform int dstEOTF;
uniform vec3 redPrimary;
uniform vec3 greenPrimary;
uniform vec3 bluePrimary;
uniform vec3 whitePoint;
uniform float maxLuminance;
uniform bool linearizeMaximumsClp;
uniform float sourceMinimumTSDMaximum;
uniform float destinationMinimumTSDMaximum;

// ---------------------------------------------------------------------------
// Minimal, self-contained subset of KWin's colorspace.glsl. The EOTF enum
// values mirror TransferFunction in core/colorspace.h (Linear = 0, sRGB = 1,
// Gamma22Approximation = 2, SMPTE_ST_2084 = 3, HLG = 4).
// ---------------------------------------------------------------------------

const float PQ_M1 = 0.1593017578125;
const float PQ_M2 = 78.84375;
const float PQ_C1 = 0.3424235500;
const float PQ_C2 = 0.0415618501;
const float PQ_C3 = 0.0000133200;

float transferFunctionToLinear(float c, int eotf) {
    switch (eotf) {
    case 0: // Linear
        return c;
    case 1: // sRGB
        return c <= 0.04045 ? c / 12.92 : pow((c + 0.055) / 1.055, 2.4);
    case 2: // Gamma 2.2 approximation used by many displays
        return pow(c, 2.2);
    case 3: // SMPTE ST 2084 (PQ), normalized against maxLuminance
        {
            float cp = pow(clamp(c, 0.0, 1.0), 1.0 / PQ_M2);
            return pow(max(cp - PQ_C1, 0.0) / (PQ_C2 - PQ_C3 * cp), 1.0 / PQ_M1) * 10000.0 / maxLuminance;
        }
    case 4: // HLG inverse OETF
        {
            const float a = 0.17883277;
            const float b = 0.28466892;
            const float c0 = 0.55991073;
            return c <= 0.5 ? (c * c) / a : (exp((c - b) / a) + c0) / 12.0;
        }
    default:
        return c;
    }
}

float linearToTransferFunction(float c, int eotf) {
    switch (eotf) {
    case 0: // Linear
        return c;
    case 1: // sRGB
        return c <= 0.0031308 ? c * 12.92 : 1.055 * pow(c, 1.0 / 2.4) - 0.055;
    case 2: // Gamma 2.2 approximation
        return pow(c, 1.0 / 2.2);
    case 3: // SMPTE ST 2084 (PQ), normalized against maxLuminance
        {
            float y = pow(clamp(c, 0.0, 1.0) * maxLuminance / 10000.0, PQ_M1);
            return pow((PQ_C1 + PQ_C2 * y) / (1.0 + PQ_C3 * y), PQ_M2);
        }
    case 4: // HLG OETF
        {
            const float a = 0.17883277;
            const float b = 0.28466892;
            const float c0 = 0.55991073;
            return c <= 1.0 / 12.0 ? sqrt(3.0 * a * c) : a * log(12.0 * c - b) + c0;
        }
    default:
        return c;
    }
}

vec4 toLinearColor(vec4 color, int eotf, vec3 r, vec3 g, vec3 b, vec3 wp) {
    // No primaries conversion is applied here: the backdrop was grabbed from
    // this very same render target and is written back to it, so any matrix
    // would cancel out again. Only the transfer function matters.
    return vec4(transferFunctionToLinear(color.r, eotf),
                transferFunctionToLinear(color.g, eotf),
                transferFunctionToLinear(color.b, eotf),
                color.a);
}

vec4 toTransferColor(vec4 color, int eotf, vec3 r, vec3 g, vec3 b, vec3 wp,
                     float maxLum, bool linearizeMaxClp,
                     float srcMinTSD, float dstMinTSD) {
    return vec4(linearToTransferFunction(clamp(color.r, 0.0, 1.0), eotf),
                linearToTransferFunction(clamp(color.g, 0.0, 1.0), eotf),
                linearToTransferFunction(clamp(color.b, 0.0, 1.0), eotf),
                color.a);
}

void main() {
    // This fragment's position inside the cursor quad, in texture space.
    const vec2 cursorUv = vec2(texcoord.x, 1.0 - texcoord.y);

    // Sample the background at exactly this fragment's device position.
    // The vertex shader maps the cursor quad one-to-one onto the viewport,
    // hence gl_FragCoord already points at the right pixel of the full-size
    // background texture bound to BackgroundTextureUnit.
    const vec2 bgSize = vec2(textureSize(samplers[BackgroundTextureUnit], 0));
    vec4 backdrop = texture(samplers[BackgroundTextureUnit], gl_FragCoord.xy / bgSize);

    // Invert the backdrop like Plasma's invert effect does (1.0 - color),
    // but in linear light so the operation is colorspace-correct.
    vec4 linearBackdrop = toLinearColor(backdrop, srcEOTF, redPrimary, greenPrimary, bluePrimary, whitePoint);
    linearBackdrop.rgb = clamp(vec3(1.0) - linearBackdrop.rgb, 0.0, 1.0);
    vec4 invertedBackdrop = toTransferColor(linearBackdrop, dstEOTF,
                                            redPrimary, greenPrimary, bluePrimary, whitePoint,
                                            maxLuminance, linearizeMaximumsClp,
                                            sourceMinimumTSDMaximum, destinationMinimumTSDMaximum);

    // Use the cursor's alpha as a coverage mask: opaque pixels show the
    // fully inverted backdrop, translucent edge pixels blend it with the
    // untouched backdrop, transparent pixels leave the backdrop alone.
    const float coverage = texture(samplers[CursorTextureUnit], cursorUv).a;

    fragColor = mix(backdrop, invertedBackdrop, coverage);
}
